# Modern matplotlib style for clean, readable, publication-quality plots.
# Use: plt.style.use('~/.agents/skills/scientific-figures/assets/modern.mplstyle')

# Figure aesthetics
figure.facecolor: white
figure.dpi: 150
figure.autolayout: True
savefig.dpi: 300
savefig.facecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.02

# Axes
axes.facecolor: white
axes.edgecolor: "#CCCCCC"
axes.linewidth: 0.6
axes.grid: True
axes.grid.axis: both
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True

# Ticks - larger, cleaner
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.5
ytick.major.size: 3.5
xtick.minor.size: 2
ytick.minor.size: 2
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.4
ytick.minor.width: 0.4
xtick.color: "#666666"
ytick.color: "#666666"

# Grid - very subtle, dark, transparent, thin
grid.color: "#E8E8E8"
grid.linewidth: 0.3
grid.linestyle: -
grid.alpha: 0.4

# Font - clean, readable with better fallback
font.family: sans-serif
font.sans-serif: DejaVu Sans, Bitstream Vera Sans, Computer Modern Sans Serif, Lucida Grande, Verdana, Geneva, Lucid, Arial, Helvetica, Avant Garde, sans-serif
font.size: 11
font.weight: normal
axes.titlesize: 13
axes.titleweight: semibold
axes.titlepad: 15
axes.labelsize: 11
axes.labelweight: normal
axes.labelcolor: "#444444"
legend.fontsize: 9
legend.title_fontsize: 10

# Lines - clean
lines.linewidth: 1.8
lines.markersize: 5.5
lines.markeredgewidth: 0.4
lines.solid_capstyle: round
lines.antialiased: True

# Colors - refined, cohesive modern palette (darker, richer)
axes.prop_cycle: cycler(color=["2563EB", "DC2626", "059669", "D97706", "7C3AED", "DB2777", "0891B2", "EA580C", "65A30D", "4F46E5"])

# Legend - clean, minimal
legend.frameon: True
legend.framealpha: 0.9
legend.edgecolor: "#EEEEEE"
legend.fancybox: True
legend.loc: best
legend.borderpad: 0.5
legend.labelspacing: 0.3

# Patches (bars, etc)
patch.edgecolor: "#CCCCCC"
patch.linewidth: 0.5
patch.facecolor: "2563EB"

# Error bars
errorbar.capsize: 3

# Boxplot
boxplot.showcaps: True
boxplot.showbox: True
boxplot.showfliers: True
boxplot.whiskerprops.linestyle: -

# Histogram
hist.bins: auto

# Scatter
scatter.marker: o

# Date formatting
date.autoformatter.year: %Y
date.autoformatter.month: %b %Y
date.autoformatter.day: %b %d, %Y
