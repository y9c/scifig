# Scientific Publication Quality Matplotlib Style
# Optimized for academic research publication
# Usage: plt.style.use('~/.agents/skills/scientific-figures/assets/scientific_publication.mplstyle')

# ============================================================================
# FIGURE SETTINGS
# ============================================================================
figure.facecolor: white
figure.dpi: 300
figure.autolayout: False

# High-resolution output for print
savefig.dpi: 600
savefig.facecolor: white
savefig.edgecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.08

# Standard journal figure sizes (inches)
figure.figsize: 3.5, 2.625

# ============================================================================
# FONT SETTINGS - Clean, scientific
# ============================================================================
font.family: sans-serif
font.sans-serif: Arial, Helvetica, Liberation Sans, DejaVu Sans, sans-serif
font.size: 9
font.weight: normal

# Titles and labels with refined spacing
axes.titlesize: 10
axes.titleweight: bold
axes.titlepad: 12
axes.titlecolor: black

axes.labelsize: 9
axes.labelweight: normal
axes.labelcolor: black
axes.labelpad: 6

# ============================================================================
# AXES SETTINGS - Pure white scientific look
# ============================================================================
axes.facecolor: white
axes.edgecolor: black
axes.linewidth: 0.8

# Only bottom and left spines
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True

# Grid - subtle, behind data
axes.grid: True
grid.color: E0E0E0
grid.linewidth: 0.4
grid.linestyle: -
grid.alpha: 0.5
axes.axisbelow: True

# ============================================================================
# COLOR PALETTE - Modern Scientific Colors
# Professional, colorblind-safe, harmonious
# ============================================================================
axes.prop_cycle: cycler('color', ['3A6BC5', 'D4654A', '4A9F6F', 'DE9E4A', 'B5637D', '4A9496', '6A6CB2', '5A6578'])

# Patch (bars, filled areas)
patch.edgecolor: none
patch.linewidth: 0
patch.facecolor: 3A6BC5

# ============================================================================
# LINE SETTINGS - Thicker, more visible
# ============================================================================
lines.linewidth: 1.5
lines.markersize: 5
lines.markeredgewidth: 0.8
lines.markeredgecolor: white
lines.solid_capstyle: round
lines.solid_joinstyle: round
lines.antialiased: True

# ============================================================================
# LEGEND SETTINGS - Clean frame
# ============================================================================
legend.fontsize: 8
legend.title_fontsize: 9
legend.labelspacing: 0.3
legend.handlelength: 2
legend.handleheight: 0.8
legend.handletextpad: 0.4
legend.borderpad: 0.4
legend.frameon: True
legend.framealpha: 0.95
legend.edgecolor: E0E0E0
legend.fancybox: True
legend.shadow: False
legend.loc: upper right

# ============================================================================
# TICK SETTINGS - Refined
# ============================================================================
xtick.labelsize: 8
ytick.labelsize: 8
xtick.direction: out
ytick.direction: out
xtick.major.size: 3
xtick.major.width: 0.8
xtick.minor.size: 1.5
xtick.minor.width: 0.4
xtick.color: 666666
ytick.color: 666666
xtick.top: False
ytick.right: False

# Tick padding for better spacing
xtick.major.pad: 3
ytick.major.pad: 3

# ============================================================================
# SCATTER PLOT - Refined
# ============================================================================
scatter.marker: o
scatter.edgecolors: white

# ============================================================================
# ERROR BARS - Refined
# ============================================================================
errorbar.capsize: 3

# ============================================================================
# BOX PLOT - Refined
# ============================================================================
boxplot.showcaps: True
boxplot.showbox: True
boxplot.showfliers: False
boxplot.whiskerprops.linestyle: -
boxplot.whiskerprops.linewidth: 1
boxplot.boxprops.linewidth: 1
boxplot.capprops.linewidth: 1
boxplot.medianprops.color: 333333
boxplot.medianprops.linewidth: 1.2

# ============================================================================
# HISTOGRAM
# ============================================================================
hist.bins: auto

# ============================================================================
# MATHTEXT
# ============================================================================
mathtext.fontset: custom
mathtext.default: regular

# ============================================================================
# AXES FORMATTING
# ============================================================================
axes.formatter.use_mathtext: True
axes.formatter.limits: -3, 3
axes.formatter.useoffset: False
